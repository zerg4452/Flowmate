<Window x:Class="PersonalTaskManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:PersonalTaskManager.App.Infrastructure"
        mc:Ignorable="d"
        Title="개인화 업무관리 툴"
        Height="940"
        Width="1480"
        MinHeight="780"
        MinWidth="1240"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{Binding FontFamily}"
        FontSize="{Binding FontSize}"
        Foreground="{Binding ForegroundColor}">
    <Window.Resources>
        <infra:StringEqualsToVisibilityConverter x:Key="ViewVisibility" />
        <infra:GuidEqualsToVisibilityConverter x:Key="GuidMatch" />
        <infra:GuidEqualsToVisibilityConverter x:Key="GuidNotMatch" Invert="True" />
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />

        <!-- Board task card -->
        <Style x:Key="TaskCard" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,4,8,4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{Binding BackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="20,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,0,0,28">
                    <TextBlock Text="업무관리"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Personal Task Manager"
                               Foreground="#9FB6E6"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="메인 업무화면" Style="{StaticResource NavButton}" Command="{Binding SelectViewCommand}" CommandParameter="Main" />
                    <Button Content="프로젝트 관리" Style="{StaticResource NavButton}" Command="{Binding SelectViewCommand}" CommandParameter="Projects" />
                    <Button Content="통계" Style="{StaticResource NavButton}" Command="{Binding SelectViewCommand}" CommandParameter="Statistics" />
                    <Button Content="옵션" Style="{StaticResource NavButton}" Command="{Binding SelectViewCommand}" CommandParameter="Options" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#14000000"
                        CornerRadius="10"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="총 투자시간" Foreground="#9FB6E6" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalProjectMinutesText}"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1" Margin="24">
            <!-- Reminder banner -->
            <Border x:Name="ReminderBanner"
                    Background="#FFFBEB"
                    BorderBrush="#FCD34D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    VerticalAlignment="Top"
                    Panel.ZIndex="30"
                    Effect="{StaticResource CardShadow}"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReminderMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-16" To="0" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="#F59E0B" Margin="0,0,12,0">
                        <TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="확인" Width="68" VerticalAlignment="Center" Command="{Binding ClearReminderCommand}" />
                    <TextBlock Text="{Binding ReminderMessage}" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ============ MAIN VIEW ============ -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Main}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="필터">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="프로젝트" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProjectFilter}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="시작일" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding FilterStartDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="종료일" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding FilterEndDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="검색어" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="4" Content="조회" Width="84" Height="38" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyFiltersCommand}" />
                    </Grid>
                </GroupBox>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BoardColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300"
                                        Margin="0,0,18,4"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Effect="{StaticResource CardShadow}"
                                        AllowDrop="True"
                                        DragOver="StatusColumn_DragOver"
                                        Drop="StatusColumn_Drop">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{Binding HeaderColor}" CornerRadius="12,12,0,0" Padding="0,13">
                                            <TextBlock Text="{Binding StatusName}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                        </Border>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="640">
                                          <Grid MinHeight="80">
                                            <TextBlock Text="작업 없음"
                                                       Foreground="#94A3B8"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProjectGroups.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding ProjectGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <Border Background="{Binding HeaderColor}" CornerRadius="6" Margin="8,8,8,2" Padding="10,5">
                                                                <TextBlock Text="{Binding ProjectName}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" />
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource TaskCard}"
                                                                                Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                PreviewMouseLeftButtonDown="TaskButton_PreviewMouseLeftButtonDown"
                                                                                PreviewMouseMove="TaskButton_PreviewMouseMove">
                                                                            <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" Foreground="#1E293B" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                          </Grid>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ====== Task Detail Popup ====== -->
                <Grid Grid.RowSpan="2" Panel.ZIndex="40">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTaskDetailOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border x:Name="DetailDim" Background="#5C0F172A" MouseLeftButtonDown="DetailOverlay_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskDetailOpen}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border x:Name="DetailCard"
                            Width="780"
                            MaxHeight="780"
                            Background="White"
                            CornerRadius="14"
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Effect="{StaticResource PopupShadow}"
                            MouseLeftButtonDown="PopupContent_MouseLeftButtonDown">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskDetailOpen}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.94" To="1" Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.94" To="1" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="닫기" Width="76" Click="CloseTaskDetail_Click" />
                                    <TextBlock Text="{Binding SelectedTask.Title}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding SelectedTaskTotalText}" Foreground="{StaticResource AccentDarkBrush}" FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Text="상태" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="상태 변경" Width="110" Height="38" Margin="8,4,0,4" Style="{StaticResource PrimaryButton}" Command="{Binding ChangeTaskStatusCommand}" />
                                    <ComboBox ItemsSource="{Binding SelectedProjectStatuses}"
                                              SelectedItem="{Binding SelectedTaskStatus, Mode=TwoWay}"
                                              DisplayMemberPath="Name" />
                                </DockPanel>

                                <DockPanel Margin="2,12,0,2">
                                    <TextBlock Text="본문" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right"
                                            Content="수정"
                                            Width="72"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding IsBodyEditMode, Converter={StaticResource BoolToVisInverse}}"
                                            Command="{Binding StartEditBodyCommand}" />
                                </DockPanel>
                                <!-- 열람 모드 -->
                                <Border Visibility="{Binding IsBodyEditMode, Converter={StaticResource BoolToVisInverse}}"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        MinHeight="120">
                                    <RichTextBox x:Name="DetailBodyViewer"
                                                 IsReadOnly="True"
                                                 IsDocumentEnabled="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="14"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="92" />
                                </Border>
                                <!-- 수정 모드 -->
                                <StackPanel Visibility="{Binding IsBodyEditMode, Converter={StaticResource BoolToVis}}">
                                    <Button Content="이미지 삽입" Width="100" HorizontalAlignment="Left" Margin="0,0,0,6" Click="InsertDetailBodyImage_Click" />
                                    <RichTextBox x:Name="DetailBodyEditor"
                                                 MinHeight="150"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="DetailBodyEditor_TextChanged" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="본문 저장" Width="100" Style="{StaticResource PrimaryButton}" Click="SaveTaskBody_Click" />
                                        <Button Content="취소" Width="80" Margin="8,4,0,4" Command="{Binding CancelEditBodyCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <GroupBox Header="댓글 추가" Margin="0,16,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MultiLineInput}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="70"
                                                 Margin="0,4,10,8" />
                                        <Button Grid.Column="1"
                                                Content="댓글 추가"
                                                VerticalAlignment="Stretch"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddCommentCommand}" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="작업시간 입력" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="작업일" Style="{StaticResource FieldLabel}" />
                                            <DatePicker SelectedDate="{Binding TimeEntryDate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="분" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding TimeMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="메모" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding TimeMemo, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="시간 추가" Width="100" Height="38" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource PrimaryButton}" Command="{Binding AddTimeEntryCommand}" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="댓글" Margin="0,0,0,16">
                                    <ItemsControl ItemsSource="{Binding SelectedTaskComments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left"
                                                                Width="34"
                                                                Height="34"
                                                                CornerRadius="17"
                                                                Background="{StaticResource AccentBrush}"
                                                                VerticalAlignment="Top"
                                                                Margin="0,0,10,0">
                                                            <TextBlock Text="C" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                        </Border>
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Content="수정"
                                                                            Width="54"
                                                                            Padding="4,3"
                                                                            Command="{Binding DataContext.StartEditCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Content="삭제"
                                                                            Width="54"
                                                                            Margin="6,4,0,4"
                                                                            Padding="4,3"
                                                                            Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <StackPanel>
                                                                <StackPanel.Visibility>
                                                                    <MultiBinding Converter="{StaticResource GuidNotMatch}">
                                                                        <Binding Path="Id" />
                                                                        <Binding Path="DataContext.EditingCommentId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    </MultiBinding>
                                                                </StackPanel.Visibility>
                                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <StackPanel.Visibility>
                                                                    <MultiBinding Converter="{StaticResource GuidMatch}">
                                                                        <Binding Path="Id" />
                                                                        <Binding Path="DataContext.EditingCommentId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    </MultiBinding>
                                                                </StackPanel.Visibility>
                                                                <TextBox Text="{Binding DataContext.EditingCommentText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource MultiLineInput}"
                                                                         AcceptsReturn="True"
                                                                         TextWrapping="Wrap"
                                                                         MinHeight="70" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Content="저장" Width="70" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.SaveCommentEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    <Button Content="취소" Width="70" Margin="8,4,0,4" Command="{Binding DataContext.CancelCommentEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <GroupBox Header="히스토리" Margin="0,0,0,0">
                                    <ItemsControl ItemsSource="{Binding SelectedTaskHistories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Content="수정"
                                                                        Width="54"
                                                                        Padding="4,3"
                                                                        Command="{Binding DataContext.StartEditHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="삭제"
                                                                        Width="54"
                                                                        Margin="6,4,0,4"
                                                                        Padding="4,3"
                                                                        Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                            <TextBlock.Visibility>
                                                                <MultiBinding Converter="{StaticResource GuidNotMatch}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.EditingHistoryId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                        <StackPanel>
                                                            <StackPanel.Visibility>
                                                                <MultiBinding Converter="{StaticResource GuidMatch}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.EditingHistoryId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </StackPanel.Visibility>
                                                            <TextBox Text="{Binding DataContext.EditingHistoryText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource MultiLineInput}"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     MinHeight="60" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Content="저장" Width="70" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.SaveHistoryEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Content="취소" Width="70" Margin="8,4,0,4" Command="{Binding DataContext.CancelHistoryEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ PROJECTS VIEW ============ -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Projects}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <GroupBox Header="프로젝트 등록">
                        <StackPanel>
                            <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="프로젝트 추가" Style="{StaticResource PrimaryButton}" Command="{Binding AddProjectCommand}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="프로젝트 목록">
                        <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="460">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="프로젝트" Binding="{Binding Name}" Width="*" />
                                <DataGridCheckBoxColumn Header="사용" Binding="{Binding IsActive}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </StackPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="프로젝트 작업">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="사용 여부 전환" Width="140" Command="{Binding ToggleProjectActiveCommand}" />
                                <Button Content="프로젝트 삭제" Width="124" Margin="10,4,0,4" Command="{Binding DeleteProjectCommand}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="상태 관리">
                            <DataGrid ItemsSource="{Binding SelectedProjectStatuses}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="상태명" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="순서" Binding="{Binding SortOrder}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="테스크 추가">
                            <StackPanel>
                                <TextBlock Text="테스크명" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="내용" Style="{StaticResource FieldLabel}" />
                                <Button Content="이미지 삽입" Width="100" HorizontalAlignment="Left" Margin="0,0,0,6" Click="InsertNewTaskBodyImage_Click" />
                                <RichTextBox x:Name="NewTaskBodyEditor" MinHeight="100" VerticalScrollBarVisibility="Auto" TextChanged="NewTaskBodyEditor_TextChanged" />
                                <Button Content="테스크 추가" Width="110" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="AddTask_Click" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ STATISTICS VIEW ============ -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Statistics}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="통계" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <GroupBox Header="일별 투자시간" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                        <DataGrid ItemsSource="{Binding DailyStatistics}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="일자" Binding="{Binding Period}" Width="*" />
                                <DataGridTextColumn Header="분" Binding="{Binding Minutes}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="주별 투자시간" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                        <DataGrid ItemsSource="{Binding WeeklyStatistics}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="주" Binding="{Binding Period}" Width="*" />
                                <DataGridTextColumn Header="분" Binding="{Binding Minutes}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="월별 투자시간" Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                        <DataGrid ItemsSource="{Binding MonthlyStatistics}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="월" Binding="{Binding Period}" Width="*" />
                                <DataGridTextColumn Header="분" Binding="{Binding Minutes}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="연별 투자시간" Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                        <DataGrid ItemsSource="{Binding YearlyStatistics}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="연도" Binding="{Binding Period}" Width="*" />
                                <DataGridTextColumn Header="분" Binding="{Binding Minutes}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>

            <!-- ============ OPTIONS VIEW ============ -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Options}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <GroupBox Header="알림">
                        <StackPanel>
                            <CheckBox Content="오늘 작업시간 미입력 알림 사용" IsChecked="{Binding IsReminderEnabled}" Margin="0,0,0,10" />
                            <TextBlock Text="알림 시각" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ReminderTimeText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="화면">
                        <StackPanel>
                            <TextBlock Text="폰트" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="글자 크기" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="테마 프리셋" Style="{StaticResource FieldLabel}" Margin="2,8,0,2" />
                            <UniformGrid Columns="4" Margin="0,2,0,4">
                                <Button Content="라이트" Height="36" Margin="0,4,6,4" Tag="#172B4D;#F4F5F7" Click="ThemePreset_Click" />
                                <Button Content="다크" Height="36" Margin="0,4,6,4" Tag="#E2E8F0;#1E293B" Click="ThemePreset_Click" />
                                <Button Content="세피아" Height="36" Margin="0,4,6,4" Tag="#4B3621;#F4ECD8" Click="ThemePreset_Click" />
                                <Button Content="딥블루" Height="36" Margin="0,4,0,4" Tag="#DCE7FF;#0B2545" Click="ThemePreset_Click" />
                            </UniformGrid>

                            <TextBlock Text="글자색" Style="{StaticResource FieldLabel}" Margin="2,8,0,2" />
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="7" Margin="0,4,8,8"
                                        BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                        Background="{Binding ForegroundColor}" />
                                <Button DockPanel.Dock="Right" Content="선택" Width="64" Click="PickForeground_Click" />
                                <TextBox Text="{Binding ForegroundColor, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <TextBlock Text="배경색" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="7" Margin="0,4,8,8"
                                        BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                        Background="{Binding BackgroundColor}" />
                                <Button DockPanel.Dock="Right" Content="선택" Width="64" Click="PickBackground_Click" />
                                <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <Button Content="옵션 저장" Style="{StaticResource PrimaryButton}" Command="{Binding SaveOptionsCommand}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <GroupBox Grid.Column="1" Header="휴지통">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="복구" Width="80" Style="{StaticResource PrimaryButton}" Command="{Binding RestoreTrashItemCommand}" />
                            <Button Content="영구 삭제" Width="100" Margin="10,4,0,4" Command="{Binding PermanentlyDeleteTrashItemCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding TrashItems}" SelectedItem="{Binding SelectedTrashItem}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="100" />
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="삭제일시" Binding="{Binding DeletedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
