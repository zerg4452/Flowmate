<Window x:Class="PersonalTaskManager.App.MattyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="메티 가져오기"
        Height="700"
        Width="540"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FetchButton" Content="가져오기" Width="90" Height="34" Click="Fetch_Click" />
                    <Button Content="취소" Width="70" Height="34" Margin="8,0,0,0" Click="Cancel_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="메티 로그인 상태면 자동으로 가져옵니다. 로그인 화면이 뜨면 로그인 후 '가져오기'를 누르세요."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#334155"
                           FontSize="12" />
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
